# .env.example  →  copy to .env and change ALL values. Never commit .env
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
VERIFY_BASE_URL=http://localhost:5173          # production: https://verify.ucsmsc.org

# Admin bootstrap (hashed with Argon2id on first run; plaintext never stored)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!Str0ng#2026

# Secrets (server-only; never exposed to the browser)
SESSION_SECRET=replace-with-64-random-hex
SIGNING_KEY_PASSPHRASE=replace-with-long-passphrase
ENCRYPTION_KEY=replace-with-64-random-hex      # AES-256-GCM at-rest encryption